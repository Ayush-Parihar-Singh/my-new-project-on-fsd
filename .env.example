# ---------------------------------------------------------------
# LastPlate environment variables. Copy to .env and fill in.
# NEVER commit real secrets. Only NEXT_PUBLIC_* values reach the browser.
# ---------------------------------------------------------------

# App
APP_URL=http://localhost:3000
APP_ENV=development                 # development | production | test
# Required in production: at least 32 random characters (used to pepper cron secret + audit HMACs)
APP_SECRET=change-me-to-a-long-random-string-of-32+chars
# Shared secret for POST /api/cron/expire (scheduler / worker)
CRON_SECRET=change-me-cron-secret

# PostgreSQL (Prisma). PostGIS is optional; see docs/DEPLOYMENT.md
DATABASE_URL=postgresql://lastplate:lastplate@localhost:5432/lastplate?schema=public
DIRECT_URL=postgresql://lastplate:lastplate@localhost:5432/lastplate?schema=public

# Sessions & cookies
SESSION_TTL_DAYS=14
# Set to true when served over HTTPS (also automatic when APP_ENV=production)
SECURE_COOKIES=false

# Private file storage (never inside /public)
STORAGE_DIR=./storage
MAX_UPLOAD_MB=5

# Email (optional). If SMTP_HOST is empty, emails are stored in the
# "OutboundEmail" table with status LOGGED and nothing is sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="LastPlate <no-reply@lastplate.example>"

# AI (optional, server-side only). Any OpenAI-compatible Chat Completions API.
# If AI_API_KEY is empty every AI feature falls back to deterministic logic.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=15000

# Map (browser-side). OpenStreetMap tiles require attribution (already shown).
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_DEFAULT_CITY_LAT=12.9716
NEXT_PUBLIC_DEFAULT_CITY_LNG=77.5946
NEXT_PUBLIC_DEFAULT_CITY_NAME=Bengaluru

# Demo seed password for the fictional demo accounts (dev/staging only)
DEMO_PASSWORD=LastPlate-Demo-2026
