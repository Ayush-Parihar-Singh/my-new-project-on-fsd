# ---------------------------------------------------------------------------
# LastPlate environment. Copy to .env for local development and never commit .env.
# Every value is validated at startup by src/lib/env.ts.
# ---------------------------------------------------------------------------

# Public base URL of the app. Used for email links and the origin check on writes.
APP_URL=http://localhost:3000

# development | production | test. Production refuses insecure defaults.
APP_ENV=development

# Secret used to encrypt handover codes at rest. At least 16 characters; use 32+ in production.
# Changing it makes existing encrypted handover codes unreadable; those codes are then hidden, not shown.
APP_SECRET=change-me-to-a-long-random-string-of-32+chars

# Bearer token for POST /api/cron/expire. Required (16+ chars) in production.
CRON_SECRET=change-me-cron-secret-16chars

# PostgreSQL connection strings. DIRECT_URL is used by Prisma migrations (no pooler).
DATABASE_URL=postgresql://lastplate:lastplate@localhost:5432/lastplate?schema=public
DIRECT_URL=postgresql://lastplate:lastplate@localhost:5432/lastplate?schema=public

# Sessions: opaque tokens stored hashed. Cookie name is lp_session.
SESSION_TTL_DAYS=14
# Set to true when served over HTTPS (always true when APP_ENV=production).
SECURE_COOKIES=false

# Private photo storage on disk. Files are served only through authorized routes.
# Point this at a directory that is NOT inside public/ and is backed up.
STORAGE_DIR=./storage
MAX_UPLOAD_MB=5

# Email (optional). With SMTP_HOST empty, messages are stored as OutboundEmail rows (status LOGGED).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="LastPlate <no-reply@lastplate.example>"

# AI (optional). With AI_API_KEY empty, every AI feature uses deterministic rule-based fallbacks.
# Any OpenAI-compatible chat completions endpoint works.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=15000

# Demo accounts created by `npm run db:seed` (fictional data, clearly labelled as demo).
DEMO_PASSWORD=LastPlate-Demo-2026

# Optional: database used by `npm test` (must end in _test; the test reset refuses other names).
# TEST_DATABASE_URL=postgresql://postgres@localhost:5432/lastplate_test
